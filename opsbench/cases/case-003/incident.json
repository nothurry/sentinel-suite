      {
        "time": "上线后 4 天",
        "event": "一切正常，磁盘稳定在 65-70%"
      }
    ],
    "alerts": [
      {
        "time": "03:10",
        "rule": "disk_used_ratio > 0.90",
        "source": "payment-gateway-prod-2"
      },
      {
        "time": "03:45",
        "rule": "disk_used_ratio = 1.00",
        "source": "payment-gateway-prod-2"
      },
      {
        "time": "03:47",
        "rule": "HTTP 5xx ratio > 30%",
        "source": "payment-gateway"
      }
    ],
    "disk_metrics": [
      {
        "time": "00:40",
        "used_ratio": 0.68
      },
      {
        "time": "02:40",
        "used_ratio": 0.88
      },
      {
        "time": "03:30",
        "used_ratio": 0.99
      },
      {
        "time": "03:45",
        "used_ratio": 1.00
      }
    ],
    "df_output": [
      "Filesystem      Size  Used  Use%  Mounted on",
      "/dev/nvme0n1p1   64G   64G  100%  /",
      "",
      "/var/log  总计 47G：",
      "  debug.log          44G  （修改时间：03:46:59，仍在增长）",
      "  app.log             2.1G",
      "  journal/            0.9G"
    ],
    "logs": [
      {
        "time": "02:30:11",
        "source": "payment-gateway",
        "level": "ERROR",
        "msg": "risk-check timeout after 3s, request_id=pay-8812 —— 打印全量堆栈 + 完整请求体（渠道号/金额/卡号掩码），单条约 1.2MB"
      },
      {
        "time": "02:30-03:45",
        "source": "payment-gateway",
        "level": "统计",
        "msg": "同型 ERROR 日志约 6000 条/分钟，单条 1.2MB ≈ 7GB/小时写入 /var/log/debug.log"
