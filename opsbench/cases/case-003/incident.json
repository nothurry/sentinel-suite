{
  "case": "case-003-disk-full-log-flood",
  "difficulty": "easy-medium",
  "service": "支付网关服务 payment-gateway",
  "symptom": "03:47 起全部支付请求 5xx，主机磁盘使用率 100%，应用报 No space left on device。",
  "inputs": {
    "deploy_log": [
